# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets and credentials
.env
.env.*
!.env.example
*.token
*.credentials.json
*-client.json

# OAuth token caches
oauth/token.json
oauth/*.token
*token.json

# Runtime state (drive walker coverage index, cursors, library mirror)
state/cases-runner/*
state/runs/*
state/coverage-index.json
state/delta.json
state/library-mirror/
!state/cases-runner/.gitkeep

# macOS / editor cruft
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Local-only Langfuse / API key files
.langfuse
.anthropic
